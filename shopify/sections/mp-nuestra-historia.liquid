{% comment %}
  Mi Pileta · Nuestra historia
  Sección con la estética de la home Essentia (fondo negro, tipografía Raleway, patrón de puntos).
  Todo el contenido se edita desde el editor de temas. Los estilos están encapsulados en .mph-{{ section.id }}.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign milestones = section.blocks | where: 'type', 'milestone'
  assign values = section.blocks | where: 'type', 'value'
  assign stats = section.blocks | where: 'type', 'stat'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  .mph-{{ sid }} {
    --mph-bg: #0e0e0e; --mph-panel: #111111; --mph-card: #141414; --mph-ink: #f7f8fc; --mph-muted: #abb6c6;
    --mph-line: rgba(171,182,198,.16); --mph-accent: {{ section.settings.accent_color | default: '#1a00b5' }};
    --mph-max: 1360px; --mph-radius: 28px;
    color: var(--mph-ink); background: var(--mph-bg); font-family: "Raleway", sans-serif; overflow-x: hidden;
  }
  .mph-{{ sid }} *, .mph-{{ sid }} *:before, .mph-{{ sid }} *:after { box-sizing: border-box; }
  .mph-{{ sid }} img { display: block; max-width: 100%; }
  .mph-{{ sid }} a { color: inherit; text-decoration: none; }
  .mph-{{ sid }} .mph-shell { max-width: var(--mph-max); margin: 0 auto; padding-inline: 28px; position: relative; z-index: 1; }
  .mph-{{ sid }} .mph-eyebrow { display: inline-block; color: var(--mph-muted); font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; }
  .mph-{{ sid }} h1, .mph-{{ sid }} h2, .mph-{{ sid }} h3 { margin: 0; color: var(--mph-ink); font-family: "Raleway", sans-serif; font-weight: 700; letter-spacing: -.03em; }
  .mph-{{ sid }} h2 { margin-top: 14px; font-size: clamp(42px,5vw,76px); line-height: .98; }
  .mph-{{ sid }} p { color: var(--mph-muted); font-size: 17px; line-height: 1.7; font-weight: 400; }
  .mph-{{ sid }} .mph-block { padding-block: 130px; position: relative; }

  /* Botones */
  .mph-{{ sid }} .mph-button { display: inline-flex; align-items: center; gap: 10px; padding: 14px 24px; border: 1px solid transparent; border-radius: 999px; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; transition: .25s ease; }
  .mph-{{ sid }} .mph-button:hover { transform: translateY(-2px); }
  .mph-{{ sid }} .mph-button-primary { color: #fff; background: var(--mph-accent); box-shadow: 0 8px 28px rgba(26,0,181,.22); }
  .mph-{{ sid }} .mph-button-primary:hover { filter: brightness(1.15); box-shadow: 0 12px 36px rgba(26,0,181,.32); }
  .mph-{{ sid }} .mph-button-outline { color: #fff; border-color: rgba(171,182,198,.32); background: rgba(14,14,14,.38); backdrop-filter: blur(10px); }
  .mph-{{ sid }} .mph-button-outline:hover { border-color: rgba(171,182,198,.72); background: rgba(171,182,198,.08); }

  /* Patrón de puntos */
  .mph-{{ sid }} .mph-dots { position: absolute; inset: 0; pointer-events: none; z-index: 0; background-image: radial-gradient(circle, rgba(171,182,198,.22) 1px, transparent 1px); background-size: 32px 32px; }
  .mph-{{ sid }} .mph-dots.is-left { -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.6) 30%, rgba(0,0,0,.6) 70%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.6) 30%, rgba(0,0,0,.6) 70%, transparent 100%); }
  .mph-{{ sid }} .mph-dots.is-right { left: 50%; right: -40px; background-size: 28px 28px; -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.5) 20%, rgba(0,0,0,.5) 60%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.5) 20%, rgba(0,0,0,.5) 60%, transparent 100%); }

  /* Hero */
  .mph-{{ sid }} .mph-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; min-height: {{ section.settings.hero_height }}vh; padding-block: 140px 90px; }
  .mph-{{ sid }} .mph-hero-bg { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.62) contrast(1.06); }
  .mph-{{ sid }} .mph-hero:after { content: ""; position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(14,14,14,.96) 6%, rgba(14,14,14,.78) 45%, rgba(14,14,14,.22) 84%), linear-gradient(0deg, rgba(14,14,14,.92), transparent 38%); }
  .mph-{{ sid }} .mph-hero-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; width: 100%; }
  .mph-{{ sid }} .mph-hero-copy { max-width: 760px; }
  .mph-{{ sid }} .mph-hero h1 { margin-top: 18px; font-size: clamp(58px,8vw,116px); line-height: .91; }
  .mph-{{ sid }} .mph-hero-subtitle { max-width: 600px; margin: 28px 0 38px; color: rgba(255,255,255,.68); font-size: clamp(17px,2vw,20px); line-height: 1.6; }
  .mph-{{ sid }} .mph-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .mph-{{ sid }} .mph-stats { display: flex; gap: 34px; flex-shrink: 0; }
  .mph-{{ sid }} .mph-stats div { max-width: 130px; padding-left: 12px; border-left: 1px solid rgba(171,182,198,.32); }
  .mph-{{ sid }} .mph-stats b { display: block; font: 700 28px "Raleway", sans-serif; color: var(--mph-ink); }
  .mph-{{ sid }} .mph-stats span { color: var(--mph-muted); font-size: 12px; letter-spacing: .04em; line-height: 1.4; }

  /* Intro */
  .mph-{{ sid }} .mph-intro { background: var(--mph-panel); }
  .mph-{{ sid }} .mph-intro-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: 68px; align-items: center; }
  .mph-{{ sid }} .mph-stage { position: relative; min-height: 560px; overflow: hidden; border: 1px solid var(--mph-line); border-radius: var(--mph-radius); background: linear-gradient(135deg,#141414,#0e0e0e); }
  .mph-{{ sid }} .mph-stage img, .mph-{{ sid }} .mph-stage svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.68) contrast(1.06) brightness(.8); }
  .mph-{{ sid }} .mph-stage svg { fill: rgba(171,182,198,.18); background: #131313; }
  .mph-{{ sid }} .mph-stage:before { content: ""; position: absolute; z-index: 1; inset: 0; background: linear-gradient(0deg, rgba(14,14,14,.92), transparent 42%); }
  .mph-{{ sid }} .mph-stage-caption { position: absolute; z-index: 2; left: 28px; right: 28px; bottom: 26px; color: var(--mph-muted); font-size: 13px; letter-spacing: .04em; }
  .mph-{{ sid }} .mph-stage-caption strong { display: block; color: var(--mph-ink); font-size: 15px; }
  .mph-{{ sid }} .mph-rte p:first-child { margin-top: 26px; }
  .mph-{{ sid }} .mph-rte a { color: var(--mph-ink); border-bottom: 1px solid rgba(171,182,198,.4); }
  .mph-{{ sid }} .mph-rte strong { color: var(--mph-ink); }

  /* Contenido de la página (texto cargado en Shopify > Páginas) */
  .mph-{{ sid }} .mph-page { background: var(--mph-bg); }
  .mph-{{ sid }} .mph-page-body { max-width: 820px; }
  .mph-{{ sid }} .mph-page-body h1, .mph-{{ sid }} .mph-page-body h2, .mph-{{ sid }} .mph-page-body h3 { margin: 56px 0 18px; font-size: clamp(30px,3.4vw,46px); line-height: 1.05; }
  .mph-{{ sid }} .mph-page-body h3 { font-size: 24px; letter-spacing: -.01em; }
  .mph-{{ sid }} .mph-page-body > :first-child { margin-top: 0; }
  .mph-{{ sid }} .mph-page-body p, .mph-{{ sid }} .mph-page-body li { color: var(--mph-muted); font-size: 18px; line-height: 1.75; }
  .mph-{{ sid }} .mph-page-body img { width: 100%; height: auto; margin: 40px 0; border: 1px solid var(--mph-line); border-radius: 20px; }
  .mph-{{ sid }} .mph-page-body a { color: var(--mph-ink); border-bottom: 1px solid rgba(171,182,198,.4); }
  .mph-{{ sid }} .mph-page-body strong { color: var(--mph-ink); }
  .mph-{{ sid }} .mph-page-body blockquote { margin: 40px 0; padding-left: 24px; border-left: 2px solid var(--mph-accent); color: var(--mph-ink); font-size: 24px; line-height: 1.45; }

  /* Línea de tiempo */
  .mph-{{ sid }} .mph-timeline { background: var(--mph-bg); overflow: hidden; }
  .mph-{{ sid }} .mph-head { display: flex; justify-content: space-between; align-items: end; gap: 28px; margin-bottom: 56px; }
  .mph-{{ sid }} .mph-head p { max-width: 430px; margin: 0; line-height: 1.6; }
  .mph-{{ sid }} .mph-steps { position: relative; display: grid; gap: 14px; }
  .mph-{{ sid }} .mph-step { position: relative; display: grid; grid-template-columns: 220px minmax(0,1fr) 300px; gap: 40px; align-items: center; padding: 34px; border: 1px solid var(--mph-line); border-radius: 22px; background: linear-gradient(135deg,#141414,#0e0e0e); transition: .3s ease; }
  .mph-{{ sid }} .mph-step:hover { transform: translateY(-4px); border-color: rgba(171,182,198,.38); box-shadow: 0 16px 40px rgba(0,0,0,.28); }
  .mph-{{ sid }} .mph-step.no-image { grid-template-columns: 220px minmax(0,1fr); }
  .mph-{{ sid }} .mph-year { font-size: clamp(44px,4.6vw,68px); font-weight: 700; line-height: .9; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1.5px rgba(171,182,198,.8); transition: .3s ease; }
  .mph-{{ sid }} .mph-step:hover .mph-year { color: var(--mph-ink); -webkit-text-stroke-color: transparent; }
  .mph-{{ sid }} .mph-step small { display: block; margin-bottom: 10px; color: var(--mph-muted); font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .mph-{{ sid }} .mph-step h3 { font-size: 26px; letter-spacing: -.01em; }
  .mph-{{ sid }} .mph-step p { margin: 12px 0 0; font-size: 15px; line-height: 1.65; }
  .mph-{{ sid }} .mph-step-media { overflow: hidden; height: 190px; border-radius: 16px; background: #111; }
  .mph-{{ sid }} .mph-step-media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.65) brightness(.85); transition: .45s ease; }
  .mph-{{ sid }} .mph-step:hover .mph-step-media img { transform: scale(1.04); filter: saturate(.8) brightness(.95); }

  /* Valores */
  .mph-{{ sid }} .mph-values { background: var(--mph-panel); overflow: hidden; }
  .mph-{{ sid }} .mph-cards { display: grid; grid-template-columns: repeat({{ values.size | at_most: 4 | at_least: 1 }},1fr); gap: 14px; }
  .mph-{{ sid }} .mph-card { padding: 28px; min-height: 250px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--mph-line); border-radius: 20px; background: radial-gradient(circle at 100% 0%, rgba(26,0,181,.12), transparent 60%), var(--mph-card); transition: .28s ease; }
  .mph-{{ sid }} .mph-card:hover { transform: translateY(-5px); border-color: rgba(171,182,198,.38); box-shadow: 0 16px 40px rgba(0,0,0,.28); }
  .mph-{{ sid }} .mph-card-num { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 48px; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; color: var(--mph-muted); font-size: 13px; font-weight: 700; letter-spacing: .06em; }
  .mph-{{ sid }} .mph-card h3 { font-size: 22px; letter-spacing: -.01em; }
  .mph-{{ sid }} .mph-card p { margin: 10px 0 0; font-size: 14px; line-height: 1.6; }

  /* Cierre */
  .mph-{{ sid }} .mph-cta { position: relative; overflow: hidden; background: #131313; }
  .mph-{{ sid }} .mph-cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .28; mix-blend-mode: luminosity; }
  .mph-{{ sid }} .mph-cta-inner { max-width: 750px; }
  .mph-{{ sid }} .mph-cta h2 { margin: 14px 0 22px; font-size: clamp(48px,6vw,88px); line-height: .95; }
  .mph-{{ sid }} .mph-cta p { max-width: 620px; margin: 0 0 34px; color: rgba(255,255,255,.68); font-size: 18px; line-height: 1.6; }

  /* Aparición al hacer scroll */
  .mph-{{ sid }} .mph-reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s cubic-bezier(.22,1,.36,1); }
  .mph-{{ sid }} .mph-reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .mph-{{ sid }} .mph-hero-inner { flex-direction: column; align-items: flex-start; }
    .mph-{{ sid }} .mph-intro-grid { grid-template-columns: 1fr; gap: 38px; }
    .mph-{{ sid }} .mph-stage { min-height: 420px; }
    .mph-{{ sid }} .mph-step, .mph-{{ sid }} .mph-step.no-image { grid-template-columns: 1fr; gap: 20px; }
    .mph-{{ sid }} .mph-step-media { height: 220px; }
    .mph-{{ sid }} .mph-cards { grid-template-columns: repeat(2,1fr); }
  }
  @media (max-width: 560px) {
    .mph-{{ sid }} .mph-shell { padding-inline: 18px; }
    .mph-{{ sid }} .mph-block { padding-block: 88px; }
    .mph-{{ sid }} .mph-hero { padding-block: 120px 64px; }
    .mph-{{ sid }} .mph-hero h1 { font-size: 56px; }
    .mph-{{ sid }} h2 { font-size: 42px; }
    .mph-{{ sid }} .mph-stats { gap: 18px; flex-wrap: wrap; }
    .mph-{{ sid }} .mph-head { display: block; }
    .mph-{{ sid }} .mph-head p { margin-top: 18px; }
    .mph-{{ sid }} .mph-step { padding: 24px; }
    .mph-{{ sid }} .mph-stage { min-height: 320px; }
    .mph-{{ sid }} .mph-cards { grid-template-columns: 1fr; }
    .mph-{{ sid }} .mph-card { min-height: 0; }
    .mph-{{ sid }} .mph-card-num { margin-bottom: 28px; }
    .mph-{{ sid }} .mph-dots { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mph-{{ sid }} *, .mph-{{ sid }} *:before, .mph-{{ sid }} *:after { transition: none !important; animation: none !important; }
    .mph-{{ sid }} .mph-reveal { opacity: 1; transform: none; }
  }
</style>

<div class="mph-{{ sid }}" id="mph-{{ sid }}">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="mph-hero">
    <div class="mph-dots is-left" aria-hidden="true"></div>
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'mph-hero-bg', loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: section.settings.hero_image.alt | default: section.settings.hero_title }}
    {%- endif -%}
    <div class="mph-shell mph-hero-inner">
      <div class="mph-hero-copy">
        {%- if section.settings.hero_eyebrow != blank -%}<span class="mph-eyebrow">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1>{{ section.settings.hero_title | newline_to_br }}</h1>
        {%- if section.settings.hero_text != blank -%}<p class="mph-hero-subtitle">{{ section.settings.hero_text }}</p>{%- endif -%}
        {%- if section.settings.hero_button_label != blank or section.settings.hero_button2_label != blank -%}
          <div class="mph-actions">
            {%- if section.settings.hero_button_label != blank -%}<a class="mph-button mph-button-primary" href="{{ section.settings.hero_button_link | default: '#mph-historia-' | append: sid }}">{{ section.settings.hero_button_label }}</a>{%- endif -%}
            {%- if section.settings.hero_button2_label != blank -%}<a class="mph-button mph-button-outline" href="{{ section.settings.hero_button2_link | default: '/collections/all' }}">{{ section.settings.hero_button2_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if stats.size > 0 -%}
        <div class="mph-stats">
          {%- for block in stats -%}
            <div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} INTRO {%- endcomment -%}
  {%- if section.settings.show_intro -%}
    <section class="mph-block mph-intro">
      <div class="mph-dots is-right" aria-hidden="true"></div>
      <div class="mph-shell mph-intro-grid">
        <div class="mph-stage mph-reveal">
          {%- if section.settings.intro_image != blank -%}
            {{ section.settings.intro_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if section.settings.intro_caption_title != blank -%}
            <div class="mph-stage-caption"><strong>{{ section.settings.intro_caption_title }}</strong>{{ section.settings.intro_caption_text }}</div>
          {%- endif -%}
        </div>
        <div class="mph-reveal">
          {%- if section.settings.intro_eyebrow != blank -%}<span class="mph-eyebrow">{{ section.settings.intro_eyebrow }}</span>{%- endif -%}
          <h2>{{ section.settings.intro_title }}</h2>
          <div class="mph-rte">{{ section.settings.intro_text }}</div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} TEXTO CARGADO EN LA PÁGINA DE SHOPIFY {%- endcomment -%}
  {%- if section.settings.show_page_content and page.content != blank -%}
    <section class="mph-block mph-page">
      <div class="mph-shell">
        <div class="mph-page-body mph-reveal">{{ page.content }}</div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} LÍNEA DE TIEMPO {%- endcomment -%}
  {%- if milestones.size > 0 -%}
    <section class="mph-block mph-timeline" id="mph-historia-{{ sid }}">
      <div class="mph-shell">
        <div class="mph-head mph-reveal">
          <div>
            {%- if section.settings.timeline_eyebrow != blank -%}<span class="mph-eyebrow">{{ section.settings.timeline_eyebrow }}</span>{%- endif -%}
            <h2>{{ section.settings.timeline_title }}</h2>
          </div>
          {%- if section.settings.timeline_text != blank -%}<p>{{ section.settings.timeline_text }}</p>{%- endif -%}
        </div>
        <div class="mph-steps">
          {%- for block in milestones -%}
            <article class="mph-step mph-reveal{% if block.settings.image == blank %} no-image{% endif %}" {{ block.shopify_attributes }}>
              <div class="mph-year">{{ block.settings.year }}</div>
              <div>
                <small>{{ forloop.index | prepend: '0' | slice: -2, 2 }} · {{ block.settings.label }}</small>
                <h3>{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
              {%- if block.settings.image != blank -%}
                <div class="mph-step-media">
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 300px, 100vw', widths: '400, 600, 800' }}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} VALORES {%- endcomment -%}
  {%- if values.size > 0 -%}
    <section class="mph-block mph-values">
      <div class="mph-dots is-right" aria-hidden="true"></div>
      <div class="mph-shell">
        <div class="mph-head mph-reveal">
          <div>
            {%- if section.settings.values_eyebrow != blank -%}<span class="mph-eyebrow">{{ section.settings.values_eyebrow }}</span>{%- endif -%}
            <h2>{{ section.settings.values_title }}</h2>
          </div>
          {%- if section.settings.values_text != blank -%}<p>{{ section.settings.values_text }}</p>{%- endif -%}
        </div>
        <div class="mph-cards">
          {%- for block in values -%}
            <article class="mph-card mph-reveal" {{ block.shopify_attributes }}>
              <span class="mph-card-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3>{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} CIERRE {%- endcomment -%}
  {%- if section.settings.show_cta -%}
    <section class="mph-block mph-cta">
      {%- if section.settings.cta_image != blank -%}
        {{ section.settings.cta_image | image_url: width: 2000 | image_tag: class: 'mph-cta-bg', loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: '' }}
      {%- endif -%}
      <div class="mph-shell">
        <div class="mph-cta-inner mph-reveal">
          {%- if section.settings.cta_eyebrow != blank -%}<span class="mph-eyebrow">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
          <h2>{{ section.settings.cta_title | newline_to_br }}</h2>
          {%- if section.settings.cta_text != blank -%}<p>{{ section.settings.cta_text }}</p>{%- endif -%}
          <div class="mph-actions">
            {%- if section.settings.cta_button_label != blank -%}<a class="mph-button mph-button-primary" href="{{ section.settings.cta_button_link | default: '/collections/all' }}">{{ section.settings.cta_button_label }}</a>{%- endif -%}
            {%- if section.settings.cta_button2_label != blank -%}<a class="mph-button mph-button-outline" href="{{ section.settings.cta_button2_link | default: '/pages/contact' }}">{{ section.settings.cta_button2_label }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('mph-{{ sid }}');
    if (!root) return;
    var items = root.querySelectorAll('.mph-reveal');
    if (!('IntersectionObserver' in window) || window.Shopify && Shopify.designMode) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
      });
    }, { rootMargin: '0px 0px -10% 0px' });
    items.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "MP · Nuestra historia",
  "tag": "div",
  "class": "mph-section",
  "settings": [
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "accent_color", "label": "Color de acento (botones)", "default": "#1a00b5" },

    { "type": "header", "content": "Portada" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagen de fondo" },
