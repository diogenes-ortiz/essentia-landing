{%- comment -%}
  sections/mipileta-historia.liquid — Nuestra historia, con el lenguaje visual de la home
  (sections/mipileta-home.liquid): base blanca, islas negras, Raleway 200 + Hanken Grotesk,
  botones píldora negro/blanco y el acento cálido de la marca.
  Usa los mismos tipos de bloque que historia-timeline (timeline_item, stat_item, valor_item)
  para que el contenido cargado se pueda pasar tal cual.
  Todo el CSS está encapsulado en .mph-{{ section.id }} para no pisar el tema.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign hero_img = section.settings.hero_img
  if hero_img == blank
    for b in section.blocks
      if b.type == 'timeline_item' and b.settings.image != blank
        assign hero_img = b.settings.image
      endif
    endfor
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;700&family=Raleway:wght@200;300;400;700&display=swap" rel="stylesheet">

<style>
  .mph-{{ sid }}{
    --bg:#ffffff; --card:#f7f7f5; --line:#e4e4e0; --txt:#14181e; --muted:#5f656c;
    --warm:#b07a41; --dark:#0c0d0f; --ink:#14181e; --radius:30px;
    background:var(--bg);color:var(--txt);
    font-family:"Hanken Grotesk",system-ui,Arial,sans-serif;font-weight:400;line-height:1.55;
    -webkit-font-smoothing:antialiased;overflow-x:clip;
  }
  .mph-{{ sid }} *,.mph-{{ sid }} *::before,.mph-{{ sid }} *::after{box-sizing:border-box;}
  .mph-{{ sid }} img{max-width:100%;display:block;}
  .mph-{{ sid }} a{color:inherit;text-decoration:none;}
  .mph-{{ sid }} h1,.mph-{{ sid }} h2,.mph-{{ sid }} h3{margin:0;font-weight:400;line-height:1.06;color:inherit;letter-spacing:normal;}
  .mph-{{ sid }} p{margin:0;}
  .mph-{{ sid }} .container{max-width:1180px;margin:0 auto;padding:0 20px;}
  .mph-{{ sid }} .section{padding-block:clamp(56px,8vw,104px);}

  /* helpers (idénticos a la home) */
  .mph-{{ sid }} .eyebrow{font-size:.78rem;letter-spacing:.3em;color:var(--muted);text-transform:uppercase;font-weight:400;}
  .mph-{{ sid }} .center{text-align:center;}
  .mph-{{ sid }} .lead{color:var(--muted);font-weight:300;max-width:660px;}
  .mph-{{ sid }} .center .lead{margin-left:auto;margin-right:auto;}
  .mph-{{ sid }} .title{font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(2rem,4.6vw,3.4rem);letter-spacing:.01em;margin:16px 0 0;}
  .mph-{{ sid }} .title strong{font-weight:700;}
  .mph-{{ sid }} .btn{display:inline-block;padding:14px 30px;border-radius:99px;font-weight:700;cursor:pointer;font-family:inherit;border:1px solid transparent;font-size:.92rem;transition:background .25s ease,border-color .25s ease,color .25s ease;}
  .mph-{{ sid }} .btn-light{background:#fff;color:var(--ink);border-color:#fff;}
  .mph-{{ sid }} .btn-light:hover{background:transparent;color:#fff;}
  .mph-{{ sid }} .btn-ghost{border-color:rgba(255,255,255,.45);color:#e9ecef;}
  .mph-{{ sid }} .btn-ghost:hover{border-color:#fff;background:#fff;color:var(--ink);}
  .mph-{{ sid }} .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .mph-{{ sid }} .center .cta-row{justify-content:center;}

  /* aparición al scrollear */
  .mph-{{ sid }} .rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s cubic-bezier(.22,.61,.36,1);}
  .mph-{{ sid }} .rv.in{opacity:1;transform:none;}

  /* ---------- hero: isla negra con foto ---------- */
  .mph-{{ sid }} .hero{position:relative;min-height:clamp(460px,72svh,760px);display:flex;align-items:flex-end;overflow:hidden;background:#000;color:#fff;}
  .mph-{{ sid }} .hero-bg{position:absolute;inset:0;z-index:0;transform:scale(1.06);transition:transform 1.6s cubic-bezier(.22,.61,.36,1);}
  .mph-{{ sid }} .hero.on .hero-bg{transform:scale(1);}
  .mph-{{ sid }} .hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 55%;}
  .mph-{{ sid }} .hero::after{content:"";position:absolute;inset:0;z-index:1;background:
      radial-gradient(88% 92% at 54% 56%,transparent 38%,rgba(0,0,0,.66) 100%),
      linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.22) 40%,rgba(0,0,0,.35) 70%,rgba(0,0,0,.85) 100%),
      linear-gradient(90deg,rgba(0,0,0,.8) 0%,rgba(0,0,0,.5) 24%,rgba(0,0,0,.15) 46%,transparent 62%);}
  .mph-{{ sid }} .hero-copy{position:relative;z-index:2;width:100%;padding-block:120px clamp(44px,9vh,96px);}
  .mph-{{ sid }} .hero .eyebrow{color:#c8ced6;}
  .mph-{{ sid }} .hero h1{margin-top:18px;font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(2.6rem,6.4vw,5.2rem);line-height:1.02;letter-spacing:.005em;max-width:16ch;text-shadow:0 2px 24px rgba(0,0,0,.55);}
  .mph-{{ sid }} .hero h1 strong{font-weight:700;background:linear-gradient(180deg,#ffffff 0%,#f4f7fa 45%,#dde3e9 100%);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .mph-{{ sid }} .hero .sub{color:#d6dae0;font-weight:300;max-width:46ch;margin-top:20px;font-size:clamp(1rem,1.5vw,1.15rem);text-shadow:0 1px 12px rgba(0,0,0,.6);}
  .mph-{{ sid }} .hero .cta-row{margin-top:32px;}
  .mph-{{ sid }} .scroll-hint{position:absolute;left:50%;transform:translateX(-50%);bottom:28px;z-index:2;width:1px;height:44px;background:linear-gradient(180deg,rgba(255,255,255,.7),transparent);animation:mph-hint-{{ sid }} 2.4s ease-in-out infinite;}
  @keyframes mph-hint-{{ sid }}{0%,100%{opacity:.25;height:30px}50%{opacity:.9;height:52px}}

  /* ---------- marquee de años ---------- */
  .mph-{{ sid }} .strip{border-block:1px solid var(--line);background:#f3f3f1;overflow:hidden;padding:16px 0;}
  .mph-{{ sid }} .strip-track{display:flex;width:max-content;animation:mph-slide-{{ sid }} 38s linear infinite;}
  .mph-{{ sid }} .strip-track span{display:flex;align-items:center;gap:26px;padding-right:26px;white-space:nowrap;font-size:.74rem;letter-spacing:.28em;text-transform:uppercase;color:#6b7178;}
  .mph-{{ sid }} .strip-track span::after{content:"";width:5px;height:5px;border-radius:50%;background:var(--warm);opacity:.8;}
  .mph-{{ sid }} .strip:hover .strip-track{animation-play-state:paused;}
  @keyframes mph-slide-{{ sid }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ---------- línea de tiempo ---------- */
  .mph-{{ sid }} .tl{position:relative;margin-top:64px;}
  .mph-{{ sid }} .tl::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:1px;background:var(--line);transform:translateX(-50%);}
  .mph-{{ sid }} .tl-fill{position:absolute;top:0;left:50%;width:1px;height:0;background:var(--ink);transform:translateX(-50%);transition:height .2s linear;}
  .mph-{{ sid }} .tl-item{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,7vw,96px);align-items:center;}
  .mph-{{ sid }} .tl-item + .tl-item{margin-top:clamp(56px,8vw,104px);}
  .mph-{{ sid }} .tl-item:nth-child(odd of .tl-item) .tl-media{order:2;}
  .mph-{{ sid }} .tl-dot{position:absolute;left:50%;top:50%;z-index:2;width:13px;height:13px;border-radius:50%;background:#fff;border:1px solid var(--ink);transform:translate(-50%,-50%);transition:background .4s ease,box-shadow .4s ease;}
  .mph-{{ sid }} .tl-item.in .tl-dot{background:var(--warm);border-color:var(--warm);box-shadow:0 0 0 7px rgba(176,122,65,.14);}
  .mph-{{ sid }} .tl-media{position:relative;border-radius:var(--radius);overflow:hidden;aspect-ratio:4/3;background:#000;border:1px solid var(--line);}
  .mph-{{ sid }} .tl-media img{width:100%;height:100%;object-fit:cover;filter:brightness(.98);transition:transform 1.1s cubic-bezier(.22,.61,.36,1),filter .6s ease;}
  .mph-{{ sid }} .tl-item:hover .tl-media img{transform:scale(1.04);filter:brightness(1.06);}
  .mph-{{ sid }} .tl-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.32) 100%);}
  .mph-{{ sid }} .tl-media .tl-badge{position:absolute;left:18px;bottom:18px;z-index:2;font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:#e9ecef;background:rgba(0,0,0,.42);border:1px solid rgba(255,255,255,.32);backdrop-filter:blur(6px);border-radius:99px;padding:6px 14px;}
  .mph-{{ sid }} .tl-media--empty{display:flex;align-items:center;justify-content:center;background:var(--dark);}
  .mph-{{ sid }} .tl-media--empty span{font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(3rem,7vw,5.5rem);color:#3a3d42;}
  .mph-{{ sid }} .tl-year{display:block;font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(2.8rem,6vw,4.6rem);line-height:1;letter-spacing:.01em;color:var(--ink);}
  .mph-{{ sid }} .tl-year em{font-style:normal;color:var(--warm);}
  .mph-{{ sid }} .tl-txt h3{margin-top:18px;font-size:clamp(1.25rem,2vw,1.55rem);font-weight:700;letter-spacing:.01em;}
  .mph-{{ sid }} .tl-txt p{margin-top:12px;color:var(--muted);font-weight:300;font-size:1.02rem;max-width:46ch;}
  .mph-{{ sid }} .tl-txt p + p{margin-top:10px;}
  .mph-{{ sid }} .tl-num{display:block;margin-bottom:14px;font-size:.72rem;letter-spacing:.26em;text-transform:uppercase;color:#6b7178;}

  /* ---------- Mi Pileta hoy: isla negra ---------- */
  .mph-{{ sid }} .paper{background:var(--dark);color:#fff;}
  .mph-{{ sid }} .paper .eyebrow{color:#9aa1aa;}
  .mph-{{ sid }} .paper .lead{color:#b5b5b5;}
  .mph-{{ sid }} .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#26282c;border:1px solid #26282c;border-radius:22px;overflow:hidden;margin-top:48px;}
  .mph-{{ sid }} .fact{background:var(--dark);padding:clamp(26px,3.4vw,40px) clamp(22px,3vw,34px);transition:background .35s ease;}
  .mph-{{ sid }} .fact:hover{background:#121316;}
  .mph-{{ sid }} .fact b{display:block;font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(2.4rem,4.6vw,3.6rem);line-height:1;letter-spacing:.01em;color:#fff;}
  .mph-{{ sid }} .fact span{display:block;margin-top:12px;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:#9aa1aa;}

  /* ---------- valores ---------- */
  .mph-{{ sid }} .valores{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:44px;}
  .mph-{{ sid }} .valor{flex:0 1 calc((100% - 28px)/3);display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:28px 26px 30px;transition:border-color .35s ease,background .35s ease,transform .5s cubic-bezier(.22,.61,.36,1);}
  .mph-{{ sid }} .valor:hover{border-color:#c9c9c4;background:#f1f1ee;transform:translateY(-3px);}
  .mph-{{ sid }} .valor-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px;}
  .mph-{{ sid }} .valor-icon{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .mph-{{ sid }} .valor-icon svg{width:22px;height:22px;stroke:var(--ink);fill:none;stroke-width:1.3;}
  .mph-{{ sid }} .valor-icon img{width:100%;height:100%;object-fit:cover;}
  .mph-{{ sid }} .valor-n{font-family:"Raleway",sans-serif;font-weight:200;font-size:1.9rem;line-height:1;color:#b9b9b3;}
  .mph-{{ sid }} .valor b{display:block;font-size:1.05rem;font-weight:700;}
  .mph-{{ sid }} .valor p{margin-top:8px;color:var(--muted);font-size:.92rem;font-weight:300;}

  /* ---------- cierre ---------- */
  .mph-{{ sid }} .contacto{position:relative;border-radius:var(--radius);overflow:hidden;border:1px solid var(--dark);background:var(--dark);color:#fff;padding:clamp(40px,6vw,72px) clamp(24px,5vw,64px);text-align:center;}
  .mph-{{ sid }} .contacto::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 120% at 50% 0%,rgba(201,146,90,.2),transparent 60%);}
  .mph-{{ sid }} .contacto > *{position:relative;}
  .mph-{{ sid }} .contacto h2{font-family:"Raleway",sans-serif;font-weight:200;font-size:clamp(1.8rem,3.6vw,2.8rem);margin:14px 0 0;}
  .mph-{{ sid }} .contacto h2 strong{font-weight:700;}
  .mph-{{ sid }} .contacto .eyebrow{color:#9aa1aa;}
  .mph-{{ sid }} .contacto .lead{color:#b5b5b5;margin-top:16px;}
  .mph-{{ sid }} .contacto .cta-row{margin-top:30px;}

  @media(max-width:960px){
    .mph-{{ sid }} .valor{flex-basis:calc((100% - 14px)/2);}
    .mph-{{ sid }} .facts{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:760px){
    .mph-{{ sid }} .hero{min-height:0;display:block;background:var(--dark);}
    .mph-{{ sid }} .hero-bg{position:relative;aspect-ratio:5/4;transform:none;}
    .mph-{{ sid }} .hero-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.3) 0%,transparent 30%,transparent 58%,rgba(12,13,15,.75) 86%,var(--dark) 100%);}
    .mph-{{ sid }} .hero::after,.mph-{{ sid }} .scroll-hint{display:none;}
    .mph-{{ sid }} .hero-copy{padding:20px 0 40px;}
    .mph-{{ sid }} .hero h1,.mph-{{ sid }} .hero .sub{text-shadow:none;max-width:none;}
    .mph-{{ sid }} .hero .cta-row{flex-direction:column;align-items:stretch;gap:11px;}
    .mph-{{ sid }} .hero .cta-row .btn{width:100%;text-align:center;}
    .mph-{{ sid }} .tl::before,.mph-{{ sid }} .tl-fill{left:6px;transform:none;}
    .mph-{{ sid }} .tl-item{grid-template-columns:1fr;gap:22px;padding-left:34px;}
    .mph-{{ sid }} .tl-item:nth-child(odd of .tl-item) .tl-media{order:0;}
    .mph-{{ sid }} .tl-dot{left:6px;top:8px;transform:translate(-50%,0);}
    .mph-{{ sid }} .tl-media{border-radius:22px;}
  }
  @media(max-width:560px){
    .mph-{{ sid }} .valor{flex-basis:100%;}
    .mph-{{ sid }} .facts{grid-template-columns:1fr 1fr;}
    .mph-{{ sid }} .fact span{letter-spacing:.14em;font-size:.7rem;}
  }
  @media(prefers-reduced-motion:reduce){
    .mph-{{ sid }} .rv{opacity:1;transform:none;transition:none;}
    .mph-{{ sid }} .hero-bg,.mph-{{ sid }} .strip-track,.mph-{{ sid }} .scroll-hint{transition:none;animation:none;transform:none;}
  }
</style>

<div class="mph-{{ sid }}" id="mph-{{ sid }}">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="hero" data-mph-hero>
    <div class="hero-bg" aria-hidden="true">
      {%- if hero_img != blank -%}
        {{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: '' }}
      {%- endif -%}
    </div>
    <div class="hero-copy">
      <div class="container">
        {%- if section.settings.hero_eyebrow != blank -%}<p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>{%- endif -%}
        <h1>{{ section.settings.title }} <strong>{{ section.settings.title_hl }}</strong></h1>
        {%- if section.settings.subtitle != blank -%}<p class="sub">{{ section.settings.subtitle }}</p>{%- endif -%}
        <div class="cta-row">
          <a class="btn btn-light" href="#mph-tl-{{ sid }}">{{ section.settings.hero_cta | default: 'Recorrer la historia' }}</a>
          {%- if section.settings.hero_cta2 != blank -%}<a class="btn btn-ghost" href="{{ section.settings.hero_cta2_url | default: '/collections/todos-los-productos' }}">{{ section.settings.hero_cta2 }}</a>{%- endif -%}
        </div>
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true"></div>
  </section>

  {%- comment -%} MARQUEE: años + pilares {%- endcomment -%}
  {%- capture strip_items -%}
    {%- for b in section.blocks -%}{%- if b.type == 'timeline_item' -%}<span>{{ b.settings.year }} · {{ b.settings.title }}</span>{%- endif -%}{%- endfor -%}
  {%- endcapture -%}
  {%- if strip_items != blank -%}
    <div class="strip" aria-hidden="true"><div class="strip-track">{{ strip_items }}{{ strip_items }}</div></div>
  {%- endif -%}

  {%- comment -%} LÍNEA DE TIEMPO {%- endcomment -%}
  <section class="section" id="mph-tl-{{ sid }}">
    <div class="container">
      <div class="center rv">
        <p class="eyebrow">{{ section.settings.tl_eyebrow }}</p>
        <h2 class="title">{{ section.settings.tl_title }} <strong>{{ section.settings.tl_title_hl }}</strong></h2>
        {%- if section.settings.tl_lead != blank -%}<p class="lead" style="margin-top:16px;">{{ section.settings.tl_lead }}</p>{%- endif -%}
      </div>

      <div class="tl" data-mph-tl>
        <span class="tl-fill" aria-hidden="true"></span>
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'timeline_item' -%}
            {%- assign n = n | plus: 1 -%}
            <article class="tl-item rv" {{ block.shopify_attributes }}>
              <span class="tl-dot" aria-hidden="true"></span>
              {%- if block.settings.image != blank -%}
                <div class="tl-media">
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 760px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: block.settings.title }}
                  {%- if block.settings.icon_image != blank -%}<span class="tl-badge">{{ block.settings.year }}</span>{%- endif -%}
                </div>
              {%- else -%}
                <div class="tl-media tl-media--empty" aria-hidden="true"><span>{{ block.settings.year }}</span></div>
              {%- endif -%}
              <div class="tl-txt">
                <span class="tl-num">{% if n < 10 %}0{% endif %}{{ n }} — {{ section.settings.tl_eyebrow }}</span>
                <span class="tl-year">{{ block.settings.year | replace: '-', '<em>–</em>' }}</span>
                <h3>{{ block.settings.title }}</h3>
                {%- assign paras = block.settings.description | newline_to_br | split: '<br />' -%}
                {%- for p in paras -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}<p>{{ pt }}</p>{%- endif -%}{%- endfor -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} MI PILETA HOY {%- endcomment -%}
  {%- if section.settings.show_stats -%}
    <section class="section paper">
      <div class="container">
        <div class="center rv">
          <p class="eyebrow">{{ section.settings.stats_eyebrow }}</p>
          <h2 class="title">{{ section.settings.stats_title }} <strong>{{ section.settings.stats_title_hl }}</strong></h2>
          {%- if section.settings.stats_subtitle != blank -%}<p class="lead" style="margin-top:16px;">{{ section.settings.stats_subtitle }}</p>{%- endif -%}
        </div>
        <div class="facts rv" data-mph-stats>
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat_item' -%}
              <div class="fact" {{ block.shopify_attributes }}>
                <b data-target="{{ block.settings.stat_number | escape }}">{{ block.settings.stat_number }}</b>
                <span>{{ block.settings.stat_label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} VALORES {%- endcomment -%}
  {%- if section.settings.show_valores -%}
    <section class="section">
      <div class="container">
        <div class="center rv">
          <p class="eyebrow">{{ section.settings.valores_eyebrow }}</p>
          <h2 class="title">{{ section.settings.valores_title }} <strong>{{ section.settings.valores_title_hl }}</strong></h2>
        </div>
        <div class="valores">
          {%- for block in section.blocks -%}
            {%- if block.type == 'valor_item' -%}
              <article class="valor rv" {{ block.shopify_attributes }}>
                <div class="valor-top">
                  <span class="valor-icon" aria-hidden="true">
                    {%- if block.settings.valor_image != blank -%}
                      {{ block.settings.valor_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {{ block.settings.valor_icon }}
                    {%- endif -%}
                  </span>
                  <span class="valor-n">{% if block.settings.valor_number.size == 1 %}0{% endif %}{{ block.settings.valor_number }}</span>
                </div>
                <b>{{ block.settings.valor_title }}</b>
                <p>{{ block.settings.valor_description | newline_to_br | replace: '<br />', ' ' }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} CIERRE {%- endcomment -%}
  {%- if section.settings.show_cta -%}
    <section class="section" style="padding-top:0;">
      <div class="container">
        <div class="contacto rv">
          <p class="eyebrow">{{ section.settings.cta_eyebrow }}</p>
          <h2>{{ section.settings.cta_title }} <strong>{{ section.settings.cta_title_hl }}</strong></h2>
          {%- if section.settings.cta_lead != blank -%}<p class="lead">{{ section.settings.cta_lead }}</p>{%- endif -%}
          <div class="cta-row">
            {%- if section.settings.cta_btn != blank -%}<a class="btn btn-light" href="{{ section.settings.cta_btn_url | default: '/collections/todos-los-productos' }}">{{ section.settings.cta_btn }}</a>{%- endif -%}
            {%- if section.settings.cta_btn2 != blank -%}<a class="btn btn-ghost" href="{{ section.settings.cta_btn2_url | default: '/#donde-comprar' }}">{{ section.settings.cta_btn2 }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('mph-{{ sid }}');
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hero = root.querySelector('[data-mph-hero]');
    requestAnimationFrame(function () { hero && hero.classList.add('on'); });

    var items = root.querySelectorAll('.rv');
    if (!('IntersectionObserver' in window) || reduce || (window.Shopify && Shopify.designMode)) {
      items.forEach(function (el) { el.classList.add('in'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      items.forEach(function (el) { io.observe(el); });
    }

    /* la línea de tiempo se "llena" a medida que se scrollea */
    var tl = root.querySelector('[data-mph-tl]'), fill = tl && tl.querySelector('.tl-fill');
    if (tl && fill) {
      var onScroll = function () {
        var r = tl.getBoundingClientRect(), vh = window.innerHeight;
        var p = Math.min(Math.max((vh * 0.6 - r.top) / r.height, 0), 1);
        fill.style.height = (p * 100) + '%';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }

    /* contadores: anima solo la parte numérica y respeta prefijo/sufijo (+, m², años) */
    var stats = root.querySelector('[data-mph-stats]');
    if (stats && !reduce && !(window.Shopify && Shopify.designMode)) {
      var nums = stats.querySelectorAll('b[data-target]');
      var parsed = [];
      nums.forEach(function (el) {
        var t = el.getAttribute('data-target'), m = t.match(/\d[\d.,]*/);
        if (!m) return;
        var raw = m[0], val = parseInt(raw.replace(/[.,]/g, ''), 10);
        parsed.push({ el: el, pre: t.slice(0, m.index), suf: t.slice(m.index + raw.length), val: val, sep: /[.,]/.test(raw) });
        el.textContent = t.slice(0, m.index) + '0' + t.slice(m.index + raw.length);
      });
      /* se dispara apenas el bloque asoma o ya quedó arriba (por si se llega saltando con un link) */
      var started = false;
      var check = function () {
        if (started || stats.getBoundingClientRect().top > window.innerHeight * 0.85) return;
        started = true;
        window.removeEventListener('scroll', check);
        var t0 = performance.now(), dur = 1800;
        (function tick(now) {
          var k = Math.min((now - t0) / dur, 1), ease = 1 - Math.pow(1 - k, 3);
          parsed.forEach(function (p) {
            var v = Math.round(p.val * ease);
            p.el.textContent = p.pre + (p.sep ? v.toLocaleString('es-AR') : v) + p.suf;
          });
          if (k < 1) requestAnimationFrame(tick);
        })(t0);
      };
      window.addEventListener('scroll', check, { passive: true });
      check();
    }
  })();
</script>

